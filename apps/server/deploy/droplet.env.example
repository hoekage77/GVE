# Copy this to apps/server/server/.env on the droplet.
# The backend persists sessions under apps/server/.data/sessions, so no DATABASE_URL is needed.

NODE_ENV=production
PORT=8000

# Required for sandbox/runtime execution.
DAYTONA_API_KEY=
# Alternative auth path if you do not want to use an API key:
# DAYTONA_JWT=
# DAYTONA_ORGANIZATION_ID=
# DAYTONA_ORG_ID=
# DAYTONA_ORG=

# Required for model-driven generation and agent mode.
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k2.5
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# Optional runtime tuning.
FAST_MODE=true
ENABLE_ASYNC_THINKING=true
ENABLE_POST_TURN_NARRATION=true
LLM_POOL_LOG_LEVEL=warn

# Optional sandbox tuning.
RUNTIME_ACQUIRE_BUDGET_MS=12000
MANIM_PIP_INSTALL_ON_DEMAND=true
MANIM_LATEX_INSTALL_ON_DEMAND=true

# Optional fallback providers.
GROQ_API_KEY=
GEMINI_API_KEY=
FIREWORKS_API_KEY=