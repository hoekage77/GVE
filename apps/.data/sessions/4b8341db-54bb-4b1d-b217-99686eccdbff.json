        "code": "let x, y;\nlet vx, vy;\nconst radius = 25;\nconst trailLength = 30;\nlet trail = [];\n\nfunction setup() {\n  createCanvas(800, 600);\n  x = width / 2;\n  y = height / 3;\n  vx = 6;\n  vy = 2;\n}\n\nfunction draw() {\n  background(250);\n  \n  // Physics update\n  x += vx;\n  y += vy;\n  vy += 0.25; // gravity\n  \n  // Wall collisions\n  if (x > width - radius || x < radius) {\n    vx *= -0.92;\n    x = constrain(x, radius, width - radius);\n  }\n  if (y > height - radius || y < radius) {\n    vy *= -0.85;\n    y = constrain(y, radius, height - radius);\n    if (abs(vy) < 1) vy = 0;\n  }\n  \n  // Update trail history\n  trail.push({x: x, y: y});\n  if (trail.length > trailLength) {\n    trail.shift();\n  }\n  \n  // Draw trail with gradient fade\n  noStroke();\n  for (let i = 0; i < trail.length; i++) {\n    let pos = trail[i];\n    let progress = i / trail.length;\n    let alpha = progress * 180;\n    let size = radius * 2 * (0.3 + progress * 0.7);\n    fill(80, 140, 220, alpha);\n    ellipse(pos.x, pos.y, size);\n  }\n  \n  // Draw main ball\n  fill(60, 120, 200);\n  ellipse(x, y, radius * 2);\n  \n  // Specular highlight\n  fill(200, 220, 255, 180);\n  ellipse(x - radius * 0.3, y - radius * 0.3, radius * 0.6);\n}",
        "stageDurationMs": 0
      },
