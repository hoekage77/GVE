    "code": "function createFieldLine(phase, radius, height, winding) {\n  const points = [];\n  for (let i = 0; i <= 100; i++) {\n    const t = (i / 100) * Math.PI * 2 * winding;\n    const r = radius + 0.2 * Math.sin(t * 2 + phase);\n    const x = r * Math.cos(t + phase);\n    const z = r * Math.sin(t + phase);\n    const y = height * Math.sin(t * 0.5 + phase);\n    points.push(new THREE.Vector3(x, y, z));\n  }\n  return new THREE.CatmullRomCurve3(points);\n}",
